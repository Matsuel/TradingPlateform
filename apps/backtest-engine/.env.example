# Copie ce fichier en .env. Schéma : env.ts et packages/kafka/src/config/kafka.config.ts

# Kafka du docker-compose (listener hôte)
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=backtest-engine

# 16 caractères minimum, la même valeur que dans core-backend et market-service (à changer)
INTERNAL_API_KEY=

# Facultatif
MARKET_SERVICE_URL=http://localhost:8001
