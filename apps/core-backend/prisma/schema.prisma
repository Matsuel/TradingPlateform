generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BacktestStatus {
  DRAFT
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum InvestmentMode {
  LUMP_SUM
  RECURRING
}

// Règle d'exécution des achats simulés (contrat : EXECUTION_RULES)
enum ExecutionRule {
  CLOSE_ON_SCHEDULED_DAY
}

enum InvestmentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// Rebalancement vers les poids cibles (contrat : REBALANCE_FREQUENCIES)
enum RebalanceFrequency {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?
  banReason     String?
  banExpires    DateTime? @db.Timestamptz(3)

  accounts   Account[]
  sessions   Session[]
  portfolios Portfolio[]
  backtests  Backtest[]

  @@map("user")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccounts TradingAccount[]
}

model TradingAccount {
  id          String   @id @default(cuid())
  portfolioId String
  balance     Decimal  @default(0)
  currency    String   @default("EUR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model Backtest {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Paramètres conservés pour relancer le même backtest
  startDate           DateTime
  endDate             DateTime
  investmentMode      InvestmentMode
  initialAmount       Decimal              @db.Decimal(18, 2)
  recurringAmount     Decimal?             @db.Decimal(18, 2)
  investmentFrequency InvestmentFrequency?
  rebalanceFrequency  RebalanceFrequency   @default(NONE)
  feeRate             Decimal              @default(0) @db.Decimal(8, 6)
  // Symbole rejoué 100 % avec les mêmes versements, dates et frais (D9) ; null sans benchmark
  benchmarkSymbol     String?

  // Dernière exécution créée : permet de filtrer/compter par statut courant avec Prisma (mise à jour à chaque création d'exécution)
  latestExecutionId String? @unique

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations     BacktestAllocation[]
  executions      BacktestExecution[]  @relation("BacktestExecutions")
  latestExecution BacktestExecution?   @relation("LatestExecution", fields: [latestExecutionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model BacktestAllocation {
  id         String  @id @default(cuid())
  backtestId String
  symbol     String
  // Ratio au pourcent près (D2) : 0.34 = 34 % ; somme = 1 par backtest
  weight     Decimal @db.Decimal(3, 2)

  backtest Backtest @relation(fields: [backtestId], references: [id], onDelete: Cascade)

  @@unique([backtestId, symbol])
}

model BacktestExecution {
  id         String         @id @default(cuid())
  backtestId String
  status     BacktestStatus @default(PENDING)
  attempt    Int            @default(1)
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime       @default(now())

  backtest Backtest        @relation("BacktestExecutions", fields: [backtestId], references: [id], onDelete: Cascade)
  latestOf Backtest?       @relation("LatestExecution")
  result   BacktestResult?

  @@unique([backtestId, attempt])
  @@index([backtestId, createdAt])
  @@index([status])
}

model BacktestResult {
  id                      String         @id @default(cuid())
  executionId             String         @unique
  finalValue              Decimal?       @db.Decimal(18, 2)
  // Total versé, frais compris
  totalInvested           Decimal?       @db.Decimal(18, 2)
  // Frais prélevés sur les achats, devise saisie ; null pour les résultats antérieurs
  totalFees               Decimal?       @db.Decimal(18, 2)
  // Valeur finale − total versé, devise saisie ; null pour les résultats antérieurs
  profit                  Decimal?       @db.Decimal(18, 2)
  totalReturn             Decimal?       @db.Decimal(12, 6)
  totalTrades             Int            @default(0)
  // Ratio ≤ 0, hors versements
  maxDrawdown             Decimal?       @db.Decimal(12, 6)
  maxDrawdownDate         DateTime?
  // Plus haut précédant le creux du maxDrawdown ; null sans baisse et pour les résultats antérieurs
  maxDrawdownPeakDate     DateTime?
  // Premier jour où ce plus haut est retrouvé ; null si non récupéré, sans baisse et pour les résultats antérieurs
  maxDrawdownRecoveryDate DateTime?
  // Jours calendaires du plus haut à la récupération ; null si non récupéré, sans baisse et pour les résultats antérieurs
  recoveryDays            Int?
  // Ratio annuel (rendement annualisé TWR) ; null sous deux points et pour les résultats antérieurs
  cagr                    Decimal?       @db.Decimal(12, 6)
  // Ratio annuel (écart-type journalier TWR × √252) ; null sous deux points et pour les résultats antérieurs
  volatility              Decimal?       @db.Decimal(12, 6)
  // Sans unité, taux sans risque 0 ; null si volatilité nulle, sous deux points et pour les résultats antérieurs
  sharpeRatio             Decimal?       @db.Decimal(12, 6)
  // [{ date: "YYYY-MM-DD", value, invested, lumpSumValue? }], écrite une seule fois à la complétion
  equityCurve             Json           @default("[]")
  // [{ date: "YYYY-MM-DD", symbol, price, quantity, amount, fee }] : achats exécutés
  trades                  Json           @default("[]")
  // [{ symbol, quantity, value }] : positions en fin de simulation, valorisées au dernier cours
  holdings                Json           @default("[]")
  // { finalValue, totalReturn, maxDrawdown, dcaAdvantage } : même total investi en une fois ; null hors DCA et pour les résultats antérieurs
  lumpSumComparison       Json?
  // { symbol, finalValue, totalReturn, cagr, volatility, sharpeRatio, maxDrawdown, recoveryDays, excessCagr, excessVolatility, excessMaxDrawdown, excessSharpe } : benchmark rejoué (D9) ; null sans benchmark et pour les résultats antérieurs
  benchmark               Json?
  // null pour les résultats antérieurs
  executionRule           ExecutionRule?
  // { provider, priceType, fetchedAt, fingerprint } : provenance des cours ; null pour les résultats antérieurs
  dataSource              Json?
  createdAt               DateTime       @default(now())

  execution BacktestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}
