# Copie ce fichier en .env puis remplace les valeurs marquées « à changer ». Schéma : env.ts et packages/kafka/src/config/kafka.config.ts

# PostgreSQL du docker-compose (base « trading »)
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading

# Kafka du docker-compose (listener hôte)
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=core-backend

# URL publique de l'API (à changer en production)
BETTER_AUTH_URL=http://localhost:8000
# 32 caractères minimum, par exemple : openssl rand -base64 32 (à changer)
BETTER_AUTH_SECRET=
# 16 caractères minimum, la même valeur dans market-service et backtest-engine (à changer)
INTERNAL_API_KEY=

# Facultatifs (valeurs par défaut ci-dessous)
PORT=8000
WEB_URL=http://localhost:3000
MARKET_SERVICE_URL=http://localhost:8001
# Nombre de reverse proxies devant l'API (0 : aucun)
TRUST_PROXY=0
